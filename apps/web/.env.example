# Tradeline web app environment variables
# Copy to apps/web/.env.local and fill in.

# Anthropic API key — enables LLM-generated talking points on bank detail pages
# AND the AI tutor at /app/tutor. When unset, talking points fall back to
# templates and the tutor displays a "disabled" notice. No cost when unset.
# Get a key from https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-api03-...

# Resend API key — enables real email delivery for marketplace alerts to
# subscribers via /app/subscribers. When unset, alert delivery operates in
# preview mode: the API composes the alert and returns it but does not
# actually send. Free tier covers 3,000 emails/month — plenty for Phase 1.
# Get a key from https://resend.com/api-keys
# RESEND_API_KEY=re_...
# Optional: override the From address. Default is onboarding@resend.dev which
# only sends to verified addresses. For production, verify your own domain
# in Resend and use it here.
# RESEND_FROM=Tradeline <alerts@yourdomain.com>

# Optional: source the radar snapshot from a deployed URL instead of the
# local data/output/radar_snapshot.json file. Set this in production
# (Vercel) to read the GitHub Actions cron output via raw.githubusercontent.com.
# TRADELINE_SNAPSHOT_URL=https://raw.githubusercontent.com/<owner>/<repo>/data/radar_snapshot.json
