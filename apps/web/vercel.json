{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "crons": [
    {
      "path": "/api/cron/operator-digest",
      "schedule": "0 14 * * 0"
    },
    {
      "path": "/api/cron/autopilot-send",
      "schedule": "0 13 * * 1-5"
    }
  ]
}
